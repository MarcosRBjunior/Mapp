# Copie para api/.env (nunca commite o .env). Valores de exemplo, só para o banco local.
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Origem do front liberada no CORS (sem barra no fim).
WEB_ORIGIN=http://localhost:5173

# Leitura (api HTTP) e escrita/dono (migrações, seed, job). Porta 5435 = docker-compose.yml.
DATABASE_URL=postgresql://mapp_api:mapp_api@127.0.0.1:5435/mapp
DATABASE_URL_SYNC=postgresql://mapp:mapp@127.0.0.1:5435/mapp

# Job de sincronização (npm run sync -w api). Chave falsa: a real fica só no api/.env.
DATA_PROVIDER=api_ninjas
API_NINJAS_KEY=fake-api-ninjas-key
SYNC_CALLS_PER_HOUR=90
SYNC_CALLS_PER_MONTH=3000
