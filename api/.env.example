# Copie para api/.env (nunca commite o .env). Valores de exemplo, só para o banco local.
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Leitura (api HTTP) e escrita/dono (migrações, seed, job). Porta 5435 = docker-compose.yml.
DATABASE_URL=postgresql://mapp_api:mapp_api@127.0.0.1:5435/mapp
DATABASE_URL_SYNC=postgresql://mapp:mapp@127.0.0.1:5435/mapp
