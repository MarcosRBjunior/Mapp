# URL da API do Mapp (sem barra no final)
VITE_API_URL=http://localhost:3333
# Tiles do mapa (padrão: OpenStreetMap, sem chave) e a atribuição exigida
VITE_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
