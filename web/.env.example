# URL da API do Mapp (sem barra no final)
VITE_API_URL=http://localhost:3333
# Tiles do mapa (padrão: CARTO Positron) e a atribuição exigida
VITE_TILES_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
