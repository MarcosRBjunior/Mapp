{
  "name": "@mapp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "tsx scripts/check-bundle.ts dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "geo:build": "tsx scripts/build-geo.ts",
    "api:types": "tsx scripts/write-api-types.ts",
    "build:e2e": "VITE_API_URL=http://api.test VITE_TILES_URL='http://tiles.test/{z}/{x}/{y}.png' VITE_TILES_ATTRIBUTION='&copy; Tiles de teste' vite build --outDir dist-e2e",
    "build:lighthouse": "VITE_API_URL=http://localhost:5181 VITE_TILES_URL='http://localhost:5181/tiles/{z}/{x}/{y}.png' VITE_TILES_ATTRIBUTION='&copy; Tiles de teste' vite build --outDir dist-lighthouse",
    "serve:lighthouse": "tsx scripts/mock-api-server.ts",
    "lighthouse": "npm run build:lighthouse && lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.0",
    "recharts": "^3.8.0",
    "tw-animate-css": "^1.4.0"
  }
}
